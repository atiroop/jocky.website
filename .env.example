APP_NAME=Jocky
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
JOCKY_HOME_TITLE="เรื่องราวระหว่างทางของชีวิต"
JOCKY_HOME_INTRO="บางเรื่องอยากเล่า บางเรื่องอยากจำ และบางเรื่องก็แค่อยากเขียนเก็บไว้"
JOCKY_ABOUT_INTRO="พื้นที่สำหรับเก็บเรื่องราว ความคิด และสิ่งเล็ก ๆ ที่ผู้เขียนอยากจดจำ"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=jocky_database
DB_USERNAME=jocky_sql_admin
DB_PASSWORD=
DB_CHARSET=utf8mb4

R2_BUCKET=jocky-cdn-storage
R2_REGION=auto
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

CMS_ADMIN_EMAIL=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
